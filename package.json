{
  "name": "@clube-bravos/design-system",
  "version": "1.0.3",
  "description": "Design System oficial do Clube Bravos de Benefícios",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/styles/theme.css",
    "./fonts": "./dist/styles/fonts.css",
    "./assets/*": "./dist/assets/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.figma.com/npm/b16de91e-5c85-47bb-8dc8-1a87d10ef689/registry/"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:figma-map": "tsx scripts/build-figma-map.ts",
    "build:lib": "npm run build:tokens && npm run build:registry && npm run build:figma-map && vite build --config vite.config.lib.ts && tsc --project tsconfig.lib.json --emitDeclarationOnly --outDir dist && tsx scripts/copy-styles.ts",
    "pack:test": "npm run build:lib && npm pack",
    "prepublishOnly": "npm run build:lib",
    "prepare": "husky",
    "test": "vitest run --project unit",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "chromatic": "npx chromatic --project-token=chpt_d4a29212eb11988",
    "build:tokens": "style-dictionary build --config build/style-dictionary.config.mjs",
    "build:registry": "tsx scripts/build-registry.ts"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "clube-bravos",
    "tailwind"
  ],
  "author": "Clube Bravos de Benefícios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/ombrello-seguros/clube-bravos-design-system.git"
  },
