{
  "name": "clubebravos-design-system",
  "version": "1.0.0",
  "description": "Design System oficial do Clube Bravos de Benefícios",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/styles/theme.css",
    "./fonts": "./dist/styles/fonts.css",
    "./assets/*": "./dist/assets/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:lib": "vite build --config vite.config.lib.ts && tsc --project tsconfig.lib.json --emitDeclarationOnly --outDir dist && tsx scripts/copy-styles.ts",
    "prepublishOnly": "npm run build:lib",
    "pack:test": "npm run build:lib && npm pack"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "clube-bravos",
    "tailwind"
  ],
  "author": "Clube Bravos de Benefícios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clubebravos/design-system"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vite": "^6.3.5"
  }
}
